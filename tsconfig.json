{
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "files": [],
  "references": [
    { "path": "./apps/desktop" },
    { "path": "./apps/web" },
    { "path": "./apps/marketing" },
    { "path": "./apps/mobile-app" },
    { "path": "./apps/scraper" },
    { "path": "./packages/ai" },
    { "path": "./packages/core" },
    { "path": "./packages/ui" },
    { "path": "./packages/utils" },
    { "path": "./packages/backend/convex" },
    { "path": "./packages/backend/scraper" }
  ],
  "exclude": ["node_modules", "apps", "packages"]
}
