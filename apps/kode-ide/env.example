# Clerk authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Kode model routing
# Kode 1.0 runs on Nex N2 Pro (free) via OpenRouter. Premium models route through
# OpenRouter or the Vercel AI Gateway. Accepted OpenRouter key names:
# OPENROUTER_API_KEY (preferred), OPEN_ROUTER_API_KEY, OPEN_ROUTER.
OPENROUTER_API_KEY=sk-or-...
VERCEL_AI_GATEWAY_API_KEY=vck_...
