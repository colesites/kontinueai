# Kontinue AI authentication (Clerk is used headlessly; no Clerk UI is rendered)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Web app used for browser sign-in (Google, etc.). Must use the SAME Clerk
# instance as VITE_CLERK_PUBLISHABLE_KEY. Prod values go in .env.production;
# local development overrides go in .env.local.
VITE_WEB_APP_URL=https://chat.kontinueai.com

# Kode model routing
# Kode 1.0 runs on Nex N2 Pro (free) via OpenRouter. Premium models route through
# OpenRouter or the Vercel AI Gateway. Accepted OpenRouter key names:
# OPENROUTER_API_KEY (preferred), OPEN_ROUTER_API_KEY, OPEN_ROUTER.
OPENROUTER_API_KEY=sk-or-...
VERCEL_AI_GATEWAY_API_KEY=vck_...
