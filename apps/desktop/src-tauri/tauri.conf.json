{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontinue AI",
  "version": "0.1.1-alpha.3",
  "identifier": "ai.kontinue.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kontinue AI",
        "width": 1600,
        "height": 1024,
        "minWidth": 1280,
        "minHeight": 820,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 19
        },
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kontinueai"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCM0I0OEU3Q0RCRDEzNkYKUldSdkU3M041MGc3cTFFYVBZWlp6NlNlVUE3bDdZQ3EzLzZ4U05GazJBaUtzSUxDbmdGY21Ga3UK",
      "endpoints": [
        "https://github.com/colesites/kontinueai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  }
}
