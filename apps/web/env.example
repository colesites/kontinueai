# Copy this file to .env.local and fill in your values

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Get these from https://clerk.com/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# JWT Issuer Domain (Required for Convex + Clerk integration)
# Get from: Clerk Dashboard → JWT Templates → Convex → Issuer URL
# Format: https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ============================================
# CONVEX
# ============================================
# Your Convex deployment URL
NEXT_PUBLIC_CONVEX_URL=

# For Vercel production deployment only
# Get from: Convex Dashboard → Settings → Deploy Key
CONVEX_DEPLOY_KEY=

# ============================================
# VERCEL AI GATEWAY (FREE - One key for all models!)
# ============================================
# 1. Go to: https://vercel.com/dashboard
# 2. Click "AI" tab in top nav
# 3. Set up AI Gateway
# 4. Copy your Gateway API key
#
# This single key gives you access to:
# - GPT-4o, GPT-4o-mini
# - Claude 3.5 Sonnet, Claude 3.5 Haiku
# - Gemini 2.0 Flash, Gemini 1.5 Pro
AI_GATEWAY_API_KEY=

# ============================================
# KODE BACKGROUND BUILDS
# ============================================
# Set APP_URL and KODE_WEB_WORKER_SECRET in both Vercel and the Convex
# deployment. Production APP_URL is https://chat.kontinueai.com.
APP_URL=http://localhost:3000
# Generate once with `openssl rand -hex 32`, then copy the same value into the
# Vercel and Convex environment settings. Never expose it as NEXT_PUBLIC_*.
KODE_WEB_WORKER_SECRET=
# Leave unset/false to show Coming soon on chat.kontinueai.com. Set true when
# Kode is ready to launch publicly.
KODE_WEB_PRODUCTION_ENABLED=false
# Existing owner-scoped connector secret. Set it in Next.js and Convex if Kode
# should be able to read explicitly mentioned connectors in background jobs.
AGENT_TASK_SECRET=

# Vercel Sandbox uses VERCEL_OIDC_TOKEN automatically on Vercel. For local or
# non-Vercel workers, provide all three access-token credentials instead.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
