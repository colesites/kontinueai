{
  "expo": {
    "name": "Kontinue AI",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kontinue-icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kontinueai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A0C",
        "foregroundImage": "./assets/images/kontinue-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.kontinueai.app",
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kontinue-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A0C",
          "image": "./assets/images/kontinue-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0A0C",
            "image": "./assets/images/kontinue-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kontinue uses your photos so you can attach images to chats and Canvas."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kontinue uses the microphone for voice input.",
          "speechRecognitionPermission": "Kontinue uses speech recognition to turn your voice into text."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#ec4899"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
