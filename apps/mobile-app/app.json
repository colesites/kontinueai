{
  "expo": {
    "name": "Kontinue AI",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kontinue-icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kontinueai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A0C",
        "foregroundImage": "./assets/images/kontinue-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kontinueai.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Kontinue uses speech recognition to turn your voice into text.",
        "NSMicrophoneUsageDescription": "Kontinue uses the microphone for voice input."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kontinue-icon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A0C",
          "image": "./assets/images/kontinue-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0A0C",
            "image": "./assets/images/kontinue-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kontinue uses your photos so you can attach images to chats and Canvas."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kontinue uses the microphone for voice input.",
          "speechRecognitionPermission": "Kontinue uses speech recognition to turn your voice into text."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#ec4899"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "c-tech-4m",
          "project": "kontinue-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "779148953674-bui7t3mfp2en86gn5l34765hq35r37b2.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "309168072626-job6db4ids0fj0q8brklbql51tssp71r.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "cc10f014-59e5-4f77-8231-4f8568ddf73b"
      }
    }
  }
}
