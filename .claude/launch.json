{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd apps/web && bunx next dev --turbopack -p 3000"],
      "port": 3000
    },
    {
      "name": "marketing",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd apps/marketing && bun run dev"],
      "port": 3002
    },
    {
      "name": "launch-video",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd apps/launch-video && bun scripts/sync-assets.ts && bunx remotion studio --port 3005 --no-open"],
      "port": 3005
    }
  ]
}
